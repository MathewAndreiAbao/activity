{
  "name": "ionic-photogallery",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A simple photo gallery app: take a photo, see it in a grid, tap to view or delete it. Photos are saved on the device so they are still there next time you open the app.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/core": "8.5.1",
    "@capacitor/preferences": "^8.0.1",
    "@ionic/pwa-elements": "^3.4.0",
    "@ionic/vue": "^9.0.0",
    "@ionic/vue-router": "^9.0.0",
    "ionicons": "^8.1.0",
    "vue": "^3.5.0",
    "vue-router": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "@vitejs/plugin-legacy": "^8.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.3.0",
    "eslint": "^8.35.0",
    "eslint-plugin-vue": "^9.9.0",
    "jsdom": "^22.1.0",
    "terser": "^5.16.0",
    "typescript": "~5.9.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0",
    "vue-tsc": "^2.1.10"
  }
}
